# Reown (WalletConnect) project ID — get one free at https://cloud.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=

# "mainnet" or "devnet" (default: devnet)
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Used as the WalletConnect pairing metadata URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to "true" to run the app in demo mode for recording: tx routes swap the real Anchor
# instructions for a harmless Memo instruction (the wallet still shows a genuine signing popup
# and the tx still lands on devnet), and market/pool/position reads come from in-memory
# fixtures instead of live program accounts. See app/server/demo/README.md. Never set in a real
# deployment.
DEMO_MODE=false
